# Copy this file to .env.local and fill in the values you have.
# The app works fully without any of these — each feature gracefully
# falls back (generated art instead of photos, a schematic placeholder
# instead of a real map) when its keys are missing.

# Canonical site URL — used for metadataBase, canonical links, og:url,
# sitemap.xml and robots.txt. Set this once a custom production domain
# is live. Until then it's inferred from Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL env var, so SEO tags always point at a
# real, crawlable URL instead of a placeholder domain.
SITE_URL=

# Pexels API — used only by `npm run fetch:photos` to download real
# place photography into public/images/. Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# MapTiler — vector tiles for the MapLibre-based maps (Place Detail,
# Explore, Trip Planner). Free tier key: https://cloud.maptiler.com/
# Server-only on purpose: the key is never sent to the browser. All tile,
# style, and glyph requests are proxied through this app's own
# /api/map/* Route Handlers, which attach the key server-side.
MAPTILER_API_KEY=

# OpenRouteService — real driving/cycling/walking directions, travel-time
# matrices, and isochrones for the Trip Planner's routing layer. Free tier
# key: https://openrouteservice.org/dev/#/signup
# Server-only on purpose, proxied through /api/routing/* the same way as
# MapTiler above. Without a key, every routing feature keeps working via
# the Haversine + terrain-detour-factor fallback (lib/routing/providers/
# fallback.ts) — results are simply labeled as estimates instead of exact.
OPENROUTESERVICE_API_KEY=

# --- "Plan with AI" in the Trip Planner ---
# A plain-language request ("temples and a Michelin restaurant, budget 1,000,
# one day") becomes a day plan assembled from this site's own places. Set ONE
# of the two keys below. Server-only, proxied through /api/ai/plan-trip and
# rate-limited to 5 requests / 5 minutes per IP. Leave both unset and the
# "Plan with AI" button simply never renders; nothing else changes.

# Google Gemini — the default provider, and the free one. Get a key at
# https://aistudio.google.com/apikey (no credit card required). On the free
# tier, gemini-3.6-flash charges nothing for input, output, or thinking
# tokens; you are limited by requests per minute/day rather than by cost.
GEMINI_API_KEY=

# Anthropic — the alternative provider. Higher-quality plans on harder,
# multi-constraint requests, but unlike every other key here this one is
# METERED AND PAID (roughly THB 1-2 per plan request).
# Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which provider to use. Leave blank and whichever key is set wins, Gemini
# first when both are. Set it explicitly ("gemini" or "anthropic") to pin one
# — useful for comparing the two on the same request. Pinning a provider whose
# key is missing disables the panel rather than quietly using the other one.
AI_PROVIDER=

# Model overrides. Blank uses the defaults: gemini-3.6-flash / claude-opus-5.
GEMINI_MODEL=
ANTHROPIC_MODEL=

# --- Accounts: saved trips & favourites (see docs/setup.md for full steps) ---
# Without these, the site still works fully as a guest — the Trip Planner,
# Explore, and every browsing feature need no account at all. They're only
# needed for "Sign in", "Save plan", and the heart/favourite buttons.

# MongoDB Atlas connection string (free M0 tier is enough). Include a
# database name in the path, e.g. ".../doi-and-delta?retryWrites=true...".
# Server-only — never sent to the browser. Get one: https://cloud.mongodb.com/
MONGODB_URI=

# Auth.js session/CSRF signing secret. Generate a real one with:
#   openssl rand -base64 33
# Do not reuse this across projects or environments.
AUTH_SECRET=

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
# — see docs/setup.md for the exact redirect URI to register.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
